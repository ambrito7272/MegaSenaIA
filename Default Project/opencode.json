{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "share": "disabled",
  "compaction": { "auto": true, "tail_turns": 15 },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "Test-Path*": "allow",
      "Get-ChildItem*": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow"
  }
}
